{
  "name": "dbapp",
  "version": "0.1.0",
  "private": true,
  "description": "Rowberry local PostgreSQL desktop workspace",
  "author": "dbapp contributors",
  "type": "module",
  "main": "dist/main/index.cjs",
  "scripts": {
    "dev": "bun run build && electron .",
    "build": "bun scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings src tests scripts *.ts",
    "test": "bun scripts/test.mjs",
    "test:integration": "bun scripts/integration.mjs",
    "test:e2e": "playwright test",
    "test:e2e:postgres": "playwright test --config playwright.postgres.config.ts",
    "test:postgres:setup": "bun tests/fixtures/postgres/setup.mjs",
    "test:postgres:cleanup": "bun tests/fixtures/postgres/cleanup.mjs",
    "package": "bun run build && electron-builder --publish never",
    "verify:package": "bun scripts/verify-package.mjs",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "@napi-rs/keyring": "2.1.2",
    "@radix-ui/react-slot": "1.5.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "monaco-editor": "0.57.0",
    "pg": "8.23.1",
    "pg-cursor": "2.22.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electron/asar": "4.3.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/pg-cursor": "2.7.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "bun@1.4.2",
  "trustedDependencies": [
    "electron",
    "esbuild"
  ]
}
